    "event_type",
    "timestamp",
    "logical_time",
    "branch_id"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "logical_time": {
      "type": "integer"
    },
    "branch_id": {
      "type": "string"
    },
    "intention_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "semantic_diff": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}