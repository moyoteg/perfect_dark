{
  "name": "perfect-dark-asset-upgrader",
  "productName": "Perfect Dark Kit — Asset Upgrader",
  "version": "0.2.0",
  "description": "Perfect Dark Kit — mass texture upgrade supervisor for mods",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir",
    "build:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perfectdark.kit.asset-upgrader",
    "productName": "Perfect Dark Kit — Asset Upgrader",
    "directories": {
      "output": "../../../scripts/release/asset-upgrader-electron-dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "repo-config.json",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../../../tools/pd_kit",
        "to": "pd_kit",
        "filter": ["kit.json", "electron_paths.js"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [{ "target": "dir", "arch": ["arm64", "x64"] }],
      "identity": null
    },
    "asar": true
  }
}
