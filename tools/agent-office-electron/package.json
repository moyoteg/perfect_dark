{
  "name": "virtual-agent-office",
  "productName": "Virtual Agent Office",
  "version": "0.1.0",
  "description": "Launch the Perfect Dark dataDyne G5 virtual agent simulation map",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir",
    "build:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perfectdark.agent-office",
    "productName": "Virtual Agent Office",
    "directories": {
      "output": "../../scripts/release/agent-office-dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "repo-config.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../pd_kit",
        "to": "pd_kit",
        "filter": ["kit.json", "electron_paths.js", "electron_single_instance.js"]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [{ "target": "dir", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Virtual Agent Office",
        "LSMultipleInstancesProhibited": true
      }
    },
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
