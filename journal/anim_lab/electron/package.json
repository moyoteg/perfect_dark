{
  "name": "perfect-dark-anim-lab",
  "productName": "PD Anim Lab",
  "version": "1.0.0",
  "description": "Perfect Dark Kit — animation parade and catalog browser",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir",
    "build:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perfectdark.kit.anim-lab",
    "productName": "PD Anim Lab",
    "directories": {
      "output": "../../../scripts/release/anim-lab-dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "repo-config.json"
    ],
    "extraResources": [
      {
        "from": "anim-lab-bundle",
        "to": "anim-lab",
        "filter": ["**/*"]
      },
      {
        "from": "../../../tools/pd_kit",
        "to": "pd_kit",
        "filter": ["kit.json", "electron_paths.js", "electron_single_instance.js"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [{ "target": "dir", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "PD Anim Lab",
        "LSMultipleInstancesProhibited": true
      }
    },
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
